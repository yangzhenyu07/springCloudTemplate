# Flask基础配置
FLASK_DEBUG=1
FLASK_ENV=development

# wtf配置
WTF_CSRF_ENABLED=False

# SQLAlchemy数据库配置
SQLALCHEMY_DATABASE_URI=postgresql://yzy:yzy@127.0.0.1:5432/yzy_db?client_encoding=utf8
# 链接池大小
SQLALCHEMY_POOL_SIZE=30
# 链接的最长时间
SQLALCHEMY_POOL_RECYCLE=3600
# 打印SQL语句
SQLALCHEMY_ECHO=True

# OpenAI服务提供者
OPENAI_API_KEY=
OPENAI_API_BASE=

# DeepSeek（OpenAI 兼容协议，换 base_url 即可接入）
DEEPSEEK_API_KEY=xxxx
DEEPSEEK_API_BASE=https://api.deepseek.com